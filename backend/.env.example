# Supabase PostgreSQL connection URL. For an IPv4/local environment, use the
# Session pooler URL shown in Supabase: Connect. Never commit its password.
DATABASE_URL=postgresql://postgres.project_ref:password@aws-region.pooler.supabase.com:5432/postgres

# Reserved for the future AI integration. Never expose this key to the mobile app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
